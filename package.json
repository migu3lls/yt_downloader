{
  "name": "yt-downloader-sdk",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "author": "Miguel Silva <miguelldsilva@outlook.com> (https://github.com/migu3lls)",
  "description": "Hardened TypeScript SDK, CLI & Next.js 15 Reference Architecture for zero-shell-injection YouTube media extraction with yt-dlp, FFmpeg and Supabase.",
  "homepage": "https://github.com/migu3lls/yt_downloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migu3lls/yt_downloader.git"
  },
  "bugs": {
    "url": "https://github.com/migu3lls/yt_downloader/issues"
  },
  "keywords": [
    "youtube-downloader",
    "yt-dlp",
    "ffmpeg",
    "cli",
    "sdk",
    "typescript",
    "nextjs",
    "supabase",
    "security",
    "command-injection-prevention",
    "media-pipeline",
    "developer-tools"
  ],
  "bin": {
    "yt-dl": "./bin/yt-dl.mjs",
    "yt-downloader": "./bin/yt-dl.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./security": "./src/lib/security/validator.ts",
    "./rate-limit": "./src/lib/security/rateLimit.ts",
    "./jobs": "./src/lib/jobs/downloadManager.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": [
    "bin/",
    "src/index.ts",
    "src/cli/",
    "src/lib/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "next build",
    "start": "next start",
    "cli": "node ./bin/yt-dl.mjs",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
